# --- Discord ---
# Real bot token from https://discord.com/developers/applications (NOT a self-bot token).
DISCORD_BOT_TOKEN=
# Optional: your server id, makes slash commands appear instantly while testing.
DISCORD_GUILD_ID=

# --- FOMO / Privy auth ---
# On fomo.family (logged in) open DevTools -> Application -> Local Storage and copy
# the value of `privy:refresh_token` (strip the surrounding quotes).
# This is the long-lived one; the bot exchanges it for a fresh 60-minute access
# token automatically and saves the rotated value to .fomo_session.json.
FOMO_PRIVY_REFRESH_TOKEN=

# Optional bootstrap: `privy:token`. Only saves one refresh call on first start.
FOMO_PRIVY_ACCESS_TOKEN=

# Rarely needed — defaults to fomo.family's Privy app id.
# PRIVY_APP_ID=cm6h485o300n3zj9yl6vpedq7

# --- Browser transport (the default; required to pass Cloudflare) ---
FOMO_TRANSPORT=browser
FOMO_CHROME_PROFILE=.chrome-profile
FOMO_CHROME_HEADLESS=0

# --- Real wallet resolution ---
# Paid/archive Solana RPC strongly recommended (public Solana prunes/throttles).
SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
FOMO_RESOLVE_WALLETS=1
FOMO_WALLET_CACHE=wallet_cache.json

# Verified EVM smart-wallet enrichment. The public Base/BSC defaults work at
# human bot traffic; replace these with paid RPCs if lookup volume grows.
FOMO_RESOLVE_EVM=1
FOMOSCAN_PUBLIC_URL=https://api-production-9541.up.railway.app
BASE_RPC=https://mainnet.base.org
BSC_RPC=https://bsc-dataseed.bnbchain.org
