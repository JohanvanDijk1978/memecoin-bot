# --- Discord ---
# Real bot token from https://discord.com/developers/applications (NOT a self-bot token).
DISCORD_BOT_TOKEN=

# --- FOMO / Privy auth ---
# On fomo.family (logged in) open DevTools -> Application -> Local Storage and copy
# the value of `privy:refresh_token` (strip the surrounding quotes).
# This is the long-lived one; the bot exchanges it for a fresh 60-minute access
# token automatically and saves the rotated value to .fomo_session.json.
FOMO_PRIVY_REFRESH_TOKEN=

# Optional bootstrap: `privy:token`. Only saves one refresh call on first start.
FOMO_PRIVY_ACCESS_TOKEN=

# Rarely needed — defaults to fomo.family's Privy app id.
# PRIVY_APP_ID=cm6h485o300n3zj9yl6vpedq7

# --- Browser transport (the default; required to pass Cloudflare) ---
FOMO_TRANSPORT=browser
FOMO_CHROME_PROFILE=.chrome-profile
FOMO_CHROME_HEADLESS=0

# --- Real wallet resolution ---
# Paid/archive Solana RPC strongly recommended (public Solana prunes/throttles).
SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Comma-separated HTTP fallbacks are tried automatically after the primary.
SOLANA_RPC_FALLBACKS=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Reserved for realtime subscriptions; current tracking remains polling-based.
SOLANA_WSS=wss://solana-mainnet.core.chainstack.com/YOUR_CHAINSTACK_KEY
FOMO_RESOLVE_WALLETS=1
FOMO_WALLET_CACHE=wallet_cache.json
# The sponsor and mint routes both stop at 12000 signatures, and FOMO's own
# throughput now puts a day-old swap behind that cap. The block route reads the
# chain at the swap's timestamp instead, so nothing can outrun it. 1 runs it as
# a second pass ONLY after the cheap routes miss; 0 restores the old behaviour
# (cheap routes only), which leaves active traders unresolved.
FOMO_WALLET_DEEP=1
# How many of the newest picked swaps that second pass may spend a slot search
# plus a getBlock per slot on.
FOMO_WALLET_DEEP_ATTEMPTS=2
# /token matches FOMO's own top-holder list against the token's on-chain owners
# by exact position. A well-separated match, corroborated by a FOMO-sponsored
# transaction on that wallet, is written to the wallet cache -- so /fomo and
# /wallet know the trader without any discovery scan. 0 keeps the naming but
# never persists it.
FOMO_ADOPT_HOLDER_WALLETS=1
# `/fomo` sends core profile data first, then gives optional wallet/on-chain
# enrichment this many seconds to update the already-visible Discord card.
FOMO_ENRICH_TIMEOUT=20

# Verified EVM smart-wallet enrichment. Alchemy HTTP endpoints provide the
# historical transfer search; public RPCs and Blockscout remain fallbacks.
FOMO_RESOLVE_EVM=1
# Historical discovery inspects this many low-liquidity/older EVM positions and
# at most this many transfer-history pages per token. Defaults are conservative.
FOMO_EVM_DISCOVERY_TOKENS=6
FOMO_EVM_DISCOVERY_PAGES=4
BASE_RPC=https://mainnet.base.org
BSC_RPC=https://bsc-dataseed.bnbchain.org
BASE_RPC_FALLBACKS=
BSC_RPC_FALLBACKS=https://bnb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_RPC_FALLBACKS=
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_FALLBACKS=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_WSS=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BSC_WSS=wss://bnb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ROBINHOOD_WSS=wss://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Robinhood Chain's Blockscout-compatible API supplies EVM buys omitted by
# FOMO's swaps feed.
ROBINHOOD_EXPLORER_API=https://robinhoodchain.blockscout.com/api/v2
ETH_EXPLORER_API=https://eth.blockscout.com/api/v2
BASE_EXPLORER_API=https://base.blockscout.com/api/v2

# --- Trader alerts ---
# /fomotrack persists subscriptions here and polls after this many seconds.
FOMO_TRACK_FILE=fomo_tracks.json
FOMO_TRACK_INTERVAL=5
# A newly observed swap at or above this USD value gets a whale alert.
FOMO_LARGE_SWAP_USD=1000

# --- Pump.fun profiles and alerts ---
# Pump profiles/callouts use public Pump endpoints. Exact buys and sells use
# SOLANA_RPC above and the official Pump/PumpSwap on-chain events.
PUMP_TRACK_FILE=pump_tracks.json
# Pump uses its own faster loop; polls never overlap if one cycle runs long.
PUMP_TRACK_INTERVAL=1
# Successful public EVM balance matches are cached for fast reverse lookup.
PUMP_EVM_CACHE_FILE=pump_evm_cache.json
# A Pump profile IS a Solana wallet, so wallet -> profile is one request rather
# than a scan. This cache is what stops /token, /wallet and /pump paying that
# request again for a wallet they have already seen -- including the wallets
# Pump has NO profile for, which /token used to re-ask on every render.
PUMP_PROFILE_CACHE_FILE=pump_profile_cache.json
# How long a known profile is trusted. A username or avatar can change, so
# unlike the FOMO wallet cache this one expires. Seconds; a negative value
# never expires.
PUMP_PROFILE_TTL=604800
# How long "this wallet has no Pump profile" is trusted, before Pump is asked
# again. Shorter, because a trader can create a profile at any time. A
# transient Pump failure is never written here -- only a real 404.
PUMP_PROFILE_NEGATIVE_TTL=21600
# What the /pump card itself considers current, as opposed to what holder
# labelling accepts. Follower counts move; a holder row's identity does not.
PUMP_PROFILE_CARD_TTL=300
# How many profile lookups run at once in a batch (/token's holder list,
# pump_map_top.py). Pump's public site API is not rate-limit documented.
PUMP_PROFILE_CONCURRENCY=8
# 0 alerts on every detected Pump trade. Raise this to suppress tiny trades.
PUMP_MIN_TRADE_USD=0
